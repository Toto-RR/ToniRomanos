---
import { notesByLang } from "../data/notes";

interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props as Props;

const COPY = {
  es: { kicker: "Notas técnicas", title: "Cómo están hechas las cosas", soon: "Próximamente" },
  en: { kicker: "Tech notes", title: "How things are built", soon: "Coming soon" },
} as const;

const t = COPY[lang];
const notes = notesByLang[lang];
---

<section class="section notes-section" id="notes">
  <div class="notes-heading">
    <div class="section-heading">
      <h2>{t.title}</h2>
    </div>
    <span class="tag tag-outline">{t.soon}</span>
  </div>

  <div class="notes-grid">
    {notes.map((note) => (
      <div class="note-card">
        <div class="note-meta">{note.meta}</div>
        <h3>{note.title}</h3>
        <p>{note.body}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .notes-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.4rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }

  .notes-heading .section-heading {
    margin-bottom: 0;
  }

  .notes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1px;
    background: var(--color-divider);
    border: 1px solid var(--color-divider);
  }

  .note-card {
    background: var(--color-bg, #161826);
    padding: 1.4rem;
    transition: background 180ms ease;
  }

  .note-card:hover {
    background: var(--color-surface, #1b1d2e);
  }

  .note-meta {
    font-size: 0.75rem;
    color: var(--color-neutral-400);
    margin-bottom: 0.5rem;
  }

  .note-card h3 {
    font-family: var(--font-heading, inherit);
    font-weight: 500;
    font-size: 1.125rem;
    margin: 0 0 0.35rem;
  }

  .note-card p {
    color: var(--color-neutral-300);
    font-size: 0.875rem;
    margin: 0;
  }
</style>
