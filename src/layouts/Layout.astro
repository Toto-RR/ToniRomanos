---
import "../styles/global.css";
import "../styles/redesign.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  lang?: "es" | "en";
}

const {
  title = "Toni Romanos | Game & Full-Stack Developer",
  description = "Portfolio de Toni Romanos: Unity, gameplay, web y sistemas interactivos. Con arcade jugable en la propia página.",
  lang = "es",
} = Astro.props;

const NAV = {
  es: [
    { key: "experience", label: "Experiencia" },
    { key: "projects", label: "Proyectos" },
    { key: "arcade", label: "Arcade" },
    { key: "studies", label: "Estudios" },
    { key: "stack", label: "Stack" },
    { key: "notes", label: "Notas" },
    { key: "aboutme", label: "About" },
  ],
  en: [
    { key: "experience", label: "Experience" },
    { key: "projects", label: "Work" },
    { key: "arcade", label: "Arcade" },
    { key: "studies", label: "Education" },
    { key: "stack", label: "Stack" },
    { key: "notes", label: "Notes" },
    { key: "aboutme", label: "About" },
  ],
} as const;

const nav = NAV[lang];
const cvPath = "/RomanosToni_CV.pdf";
const esHref = "/";
const enHref = "/en/";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="/gamepad_light.svg" type="image/svg+xml" />
    <title>{title}</title>
    <ClientRouter />
  </head>

  <body>
    <div class="page-bg"></div>

    <header class="site-header">
      <div class="container header-inner">
        <a href={lang === "en" ? enHref : esHref} class="brand">Toni Romanos</a>

        <nav class="nav">
          {nav.map((item) => <a href={`#${item.key}`}>{item.label}</a>)}
        </nav>

        <div class="nav-tools">
          <div class="lang-toggle" role="group" aria-label="Idioma">
            <a href={esHref} class="lang-opt" aria-current={lang === "es" ? "true" : undefined}>ES</a>
            <a href={enHref} class="lang-opt" aria-current={lang === "en" ? "true" : undefined}>EN</a>
          </div>
          <a class="button button-primary nav-cv" href={cvPath} target="_blank" rel="noopener noreferrer">CV</a>
        </div>
      </div>
    </header>

    <slot />
  </body>
</html>

<style>
  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .nav {
    display: flex;
    gap: 1.05rem;
    margin-left: auto;
    flex-wrap: wrap;
  }

  .nav-tools {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .lang-toggle {
    display: flex;
    padding: 2px;
    border: 1px solid var(--color-divider);
    border-radius: var(--radius, 8px);
  }

  .lang-opt {
    padding: 4px 10px;
    border-radius: calc(var(--radius, 8px) - 2px);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--color-neutral-400);
    text-decoration: none;
  }

  .lang-opt[aria-current="true"] {
    background: var(--color-accent-600, rgba(145, 132, 217, 0.35));
    color: var(--color-accent-100, var(--color-text));
  }

  .nav-cv {
    font-size: 0.78rem;
    padding: 0.45rem 0.9rem;
  }

  @media (max-width: 860px) {
    .nav {
      display: none;
    }
  }
</style>
