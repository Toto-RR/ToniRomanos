---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Arcade from "../components/Arcade.astro";
import FeaturedProjects from "../components/ProjectCard.astro";
import Experience from "../components/Experience.astro";
import TechStack from "../components/TechStack.astro";
import ContactCard from "../components/ContactCard.astro";
import Notas from "../components/Notas.astro";
import Estudios from "../components/Estudios.astro";

import { featuredProjects } from "../data/projects";
import { experience } from "../data/experience";
import { tech } from "../data/tech";

const lang = "es" as const;
---

<Layout lang={lang}>
  <Hero lang={lang} />

  <main>
    <div class="container">
      <Experience items={experience} lang={lang} />

      <FeaturedProjects items={featuredProjects} lang={lang} />
    </div>

    <Arcade lang={lang} />

    <div class="container">
      <Estudios lang={lang} />

      <section id="stack" class="section">
        <TechStack items={tech} lang={lang} />
      </section>

      <Notas lang={lang} />

      <section class="section">
        <ContactCard lang={lang} />
      </section>
    </div>
  </main>
</Layout>
